parametersSchema:
    mousrTemplates: structure([
        templateExtensions: listOf(string())
    ])

parameters:
    mousrTemplates:
        templateExtensions:
            - html.php

services:
    -
        class: Mousr\TemplatesPhpstanExtension\TemplateFileFilter
        arguments:
            templateExtensions: %mousrTemplates.templateExtensions%

    -
        class: Mousr\TemplatesPhpstanExtension\Rules\Escaping\NoUnescapedOutputRule
        tags:
            - phpstan.rules.rule
